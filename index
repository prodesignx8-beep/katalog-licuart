    function changeCalendarMonth(delta) {
        viewCalendarDate.setMonth(viewCalendarDate.getMonth() + delta);
        renderCalendar();
    }

    function renderCalendar() {
        const year = viewCalendarDate.getFullYear();
        const month = viewCalendarDate.getMonth();

        document.getElementById('calendarMonthYear').innerText = `${MONTHS_ID[month]} ${year}`;

        const grid = document.getElementById('calendarDaysGrid');
        grid.innerHTML = '';

        const firstDayIndex = new Date(year, month, 1).getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();

        const today = new Date();
        const isCurrentMonthToday = today.getFullYear() === year && today.getMonth() === month;

        for (let i = 0; i < firstDayIndex; i++) {
            const emptyCell = document.createElement('div');
            grid.appendChild(emptyCell);
        }

        for (let d = 1; d <= daysInMonth; d++) {
            const dayCell = document.createElement('button');
            dayCell.type = "button";
            
            const isTodayCell = isCurrentMonthToday && today.getDate() === d;
            const isSelectedCell = customDinoDate.getFullYear() === year && customDinoDate.getMonth() === month && customDinoDate.getDate() === d;

            let cellStyle = "h-8 w-8 text-xs font-semibold rounded-xl flex items-center justify-center mx-auto transition-all ";
            
            if (isSelectedCell) {
                cellStyle += "bg-purple-600 text-white font-extrabold shadow-md border border-purple-400";
            } else if (isTodayCell) {
                cellStyle += "bg-purple-900/60 border border-purple-500 text-purple-200 font-bold";
            } else {
                cellStyle += "text-gray-300 hover:bg-[#272238] hover:text-white";
            }

            dayCell.className = cellStyle;
            dayCell.innerText = d;
            dayCell.onclick = () => selectCalendarDate(year, month, d);

            grid.appendChild(dayCell);
        }
    }

    function selectCalendarDate(year, month, day) {
        customDinoDate = new Date(year, month, day);
        dinoActiveTab = 'custom';
        closeCalendarModal();
    }

    function selectTodayFromCalendar() {
        customDinoDate = new Date();
        dinoActiveTab = 'today';
        closeCalendarModal();
    }

    // ==========================================
    // FUNGSI MENGAMBIL DATA PRODUK
    // ==========================================
    async function fetchData(force = false) {
        const loading = document.getElementById('loading');
        const productList = document.getElementById('productList');
        const cacheKey = `${currentStore}_products_cache`;
        const storeInfo = STORES[currentStore];
        const urlAppsScript = storeInfo.url;
        
        const cachedData = localStorage.getItem(cacheKey);
        if (cachedData && !force) {
            try {
                products = JSON.parse(cachedData);
                loading.classList.add('hidden');
                renderList();
            } catch (e) {
                localStorage.removeItem(cacheKey);
            }
        } else {
            loading.classList.remove('hidden');
            productList.innerHTML = ''; 
        }

        try {
            const response = await fetch(`${urlAppsScript}?action=read&store=${currentStore}&key=${encodeURIComponent(APP_PIN)}`);
            const text = await response.text();
            
            let result;
            try {
                result = JSON.parse(text);
            } catch (jsonErr) {
                console.warn("Response is not JSON:", text);
                showToast("Akses Apps Script bermasalah (Ubah izin ke 'Anyone').");
                if (!cachedData || force) {
                    productList.innerHTML = `
                        <div class="bg-amber-950/60 border border-amber-500/50 text-amber-200 p-4 rounded-2xl text-xs text-center shadow-lg">
                            <i class="fas fa-exclamation-triangle text-amber-400 text-2xl mb-2"></i>
                            <h4 class="font-bold text-sm text-white mb-1">Gagal Membaca Data ${storeInfo.name}</h4>
                            <p class="text-[11px] text-amber-200/80 mb-3">Pastikan Google Apps Script untuk toko <b>${storeInfo.name}</b> sudah di-Deploy dengan akses <b>Anyone (Siapa saja)</b>.</p>
                        </div>
                    `;
                }
                return;
            }

            if(result.status === 'success') {
                products = result.data || [];
                localStorage.setItem(cacheKey, JSON.stringify(products));
                renderList();
                if (force) showToast(`Data ${storeInfo.name} berhasil diperbarui!`);
            } else {
                showToast(result.message || "Gagal memuat data dari server!");
            }
        } catch (error) {
            if(!cachedData) showToast("Terjadi kesalahan jaringan.");
            console.error("Fetch Data Error:", error);
        } finally {
            loading.classList.add('hidden');
        }
    }

