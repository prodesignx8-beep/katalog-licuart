    function renderList() {
        const dinoWidget = document.getElementById('dinoJoyoWidget');
        const searchInput = document.getElementById('searchInput');
        const query = searchInput.value.toLowerCase().trim();

        if(currentMode === 'home') {
            if (dinoWidget) dinoWidget.classList.remove('hidden');
            
            const filteredData = query 
                ? products.filter(p => (p.title || '').toLowerCase().includes(query) || (p.description || '').toLowerCase().includes(query)) 
                : [];
            
            renderProductCards(filteredData, true);
        } else if (currentMode === 'produk') {
            if (dinoWidget) dinoWidget.classList.add('hidden');
            
            const filteredData = query 
                ? products.filter(p => (p.title || '').toLowerCase().includes(query) || (p.description || '').toLowerCase().includes(query)) 
                : products;
            
            renderProductCards(filteredData, false);
        } else if (currentMode === 'edit') {
            if (dinoWidget) dinoWidget.classList.add('hidden');
            renderEditList();
        }
    }

