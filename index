    function updateDinoJoyoUI() {
        let targetDate = new Date();
        if (dinoActiveTab === 'tomorrow') {
            targetDate.setDate(targetDate.getDate() + 1);
        } else if (dinoActiveTab === 'custom') {
            targetDate = new Date(customDinoDate);
        }

        const dayIdx = targetDate.getDay();
        const dayName = DAYS_ID[dayIdx];
        const dateNum = targetDate.getDate();
        const monthName = MONTHS_ID[targetDate.getMonth()];
        const yearNum = targetDate.getFullYear();

        const formattedDateStr = `${dayName}, ${dateNum} ${monthName} ${yearNum}`;
        document.getElementById('dinoDateLabel').innerText = formattedDateStr;

        const info = DINO_DATA[dayIdx];
        if (info) {
            document.getElementById('dinoArahValue').innerText = info.arah;
            document.getElementById('dinoJamValue').innerText = info.jam;

            const arahContainer = document.getElementById('dinoArahDetails');
            if (arahContainer && info.bobotArah) {
                const maxVal = Math.max(...Object.values(info.bobotArah));
                arahContainer.innerHTML = Object.entries(info.bobotArah).map(([key, val]) => {
                    const isTop = val === maxVal && val > 0;
                    return `
                        <div class="p-1.5 rounded-xl transition-all ${isTop ? 'bg-purple-600/30 border border-purple-500/50 text-white font-bold shadow-sm' : 'bg-[#13111C] border border-[#272238] text-gray-400'}">
                            <span class="block text-[9px] uppercase tracking-wider">${key}</span>
                            <span class="text-xs ${isTop ? 'text-purple-200' : 'text-gray-300'}">${val}</span>
                        </div>
                    `;
                }).join('');
            }

            const jamContainer = document.getElementById('dinoJamDetails');
            if (jamContainer && info.jadwalJam) {
                const statusBadges = {
                    "Djoyo": "bg-emerald-900/50 text-emerald-300 border-emerald-500/40 font-bold",
                    "Selamat": "bg-blue-900/50 text-blue-300 border-blue-500/40 font-semibold",
