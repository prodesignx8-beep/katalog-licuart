    async function openProductModal(safeTitle, safeImageUrl, safeProductUrl) {
        const title = decodeURIComponent(safeTitle);
        const imageUrl = decodeURIComponent(safeImageUrl);
        const productUrl = decodeURIComponent(safeProductUrl);
        currentModalTitle = title;
        currentModalProductUrl = productUrl;
        
        document.getElementById('modalTitle').innerText = title;
        document.getElementById('modalLink').innerText = productUrl;
        
        const idBadge = document.getElementById('modalIdBadge');
        const numberMatch = title.match(/\d+/); 
        if (numberMatch) {
            idBadge.innerText = "#" + numberMatch[0];
            idBadge.classList.remove('hidden');
        } else {
            idBadge.classList.add('hidden');
        }

        const modalImg = document.getElementById('modalImage');
        const downloadBtn = document.getElementById('downloadBtn');
        const downloadPdfBtn = document.getElementById('downloadPdfBtn');
        
        modalImg.removeAttribute('crossorigin');
        document.getElementById('modalImage').src = imageUrl; 
        
        document.getElementById('modalQrCode').innerHTML = "";
        
        new QRCode(document.getElementById("modalQrCode"), {
            text: productUrl,
            width: 75,
            height: 75,
            colorDark : "#000000",
            colorLight : "#ffffff",
            correctLevel : QRCode.CorrectLevel.M
        });
        
        document.getElementById('productModal').classList.remove('hidden');
        document.getElementById('productModal').classList.add('flex');
        
        if(downloadBtn) {
            downloadBtn.innerHTML = '<i class="fas fa-image mr-1.5"></i> Download PNG';
            downloadBtn.disabled = false;
        }
        if(downloadPdfBtn) {
            downloadPdfBtn.innerHTML = '<i class="fas fa-file-pdf mr-1.5"></i> Download PDF';
            downloadPdfBtn.disabled = false;
        }
    }

    function closeProductModal() {
        document.getElementById('productModal').classList.add('hidden');
        document.getElementById('productModal').classList.remove('flex');
    }

    // ==========================================
    // FUNGSI DOWNLOAD CARD PNG & PDF
    // ==========================================
    async function downloadProductCard(event, format = 'png') {
        const captureArea = document.getElementById('captureArea');
        const btn = event.currentTarget;
        const originalBtnHtml = btn.innerHTML;
        const modalImg = document.getElementById('modalImage');
        const originalSrc = modalImg.src; 
        
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1.5"></i> Memproses...';
        btn.disabled = true;
        
        try {
            if (!originalSrc.startsWith('data:') && !originalSrc.includes('wsrv.nl')) {
                const proxyUrl = `https://wsrv.nl/?url=${encodeURIComponent(originalSrc)}&maxage=1d`;
                
                await new Promise((resolve, reject) => {
                    const timer = setTimeout(() => reject(new Error('Proxy Timeout')), 8000); 
                    
                    modalImg.setAttribute('crossOrigin', 'anonymous');
                    
                    modalImg.onload = () => {
                        clearTimeout(timer);
                        resolve();
                    };
                    modalImg.onerror = () => {
                        clearTimeout(timer);
                        reject(new Error('Proxy Gagal'));
                    };
                    
                    modalImg.src = proxyUrl;
                });
                
                await new Promise(r => setTimeout(r, 400));
            }

            const canvas = await html2canvas(captureArea, {
                useCORS: true,       
                allowTaint: false, 
                backgroundColor: "#ffffff", 
                scale: 2             
            });
            
            let safeFileName = currentModalTitle.replace(/[^a-z0-9]/gi, '_').toLowerCase();
            const storeName = STORES[currentStore].name;

            if (format === 'pdf') {
                const imgData = canvas.toDataURL('image/jpeg', 0.95);
                const imgWidth = canvas.width;
                const imgHeight = canvas.height;
                
                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF({
                    orientation: imgWidth > imgHeight ? 'landscape' : 'portrait',
                    unit: 'px',
                    format: [imgWidth, imgHeight]
                });
                pdf.addImage(imgData, 'JPEG', 0, 0, imgWidth, imgHeight);

                if (currentModalProductUrl) {
                    const captureRect = captureArea.getBoundingClientRect();
                    const scaleX = imgWidth / captureRect.width;
                    const scaleY = imgHeight / captureRect.height;
                    
                    const linkEl = document.getElementById('modalLink');
                    if (linkEl) {
                        const linkRect = linkEl.getBoundingClientRect();
                        const linkX = (linkRect.left - captureRect.left) * scaleX;
                        const linkY = (linkRect.top - captureRect.top) * scaleY;
                        const linkW = linkRect.width * scaleX;
                        const linkH = linkRect.height * scaleY;
                        pdf.link(linkX, linkY, linkW, linkH, { url: currentModalProductUrl });
                    }

                    const qrEl = document.getElementById('modalQrCode');
                    if (qrEl) {
                        const qrRect = qrEl.getBoundingClientRect();
                        const qrX = (qrRect.left - captureRect.left) * scaleX;
                        const qrY = (qrRect.top - captureRect.top) * scaleY;
                        const qrW = qrRect.width * scaleX;
                        const qrH = qrRect.height * scaleY;
                        pdf.link(qrX, qrY, qrW, qrH, { url: currentModalProductUrl });
                    }
                }

                pdf.save(`${safeFileName}_${storeName}.pdf`);
                showToast("Berhasil mendownload PDF dengan Link Aktif!");
            } else {
                const imageURL = canvas.toDataURL('image/png');
                const link = document.createElement('a');
                link.download = `${safeFileName}_${storeName}.png`;
                link.href = imageURL;
                link.click(); 
                showToast("Berhasil mendownload PNG!");
            }
            
        } catch (err) {
            console.error(`Gagal menyimpan ${format.toUpperCase()}:`, err);
            showToast("Gagal didownload. Server sumber gambar terlalu ketat.");
        } finally {
            modalImg.removeAttribute('crossOrigin'); 
            modalImg.src = originalSrc; 
            btn.innerHTML = originalBtnHtml;
            btn.disabled = false;
        }
    }

    // ==========================================
    // FUNGSI UTILITY (SHARE EMAIL, COPY, TOAST, SUBMIT)
    // ==========================================
    function shareViaEmail(description) {
        const subject = STORES[currentStore].emailSubject;
        const cleanBody = (description || '').replace(/\r?\n/g, '\r\n');
        const mailtoUrl = `mailto:?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(cleanBody)}`;
        window.location.href = mailtoUrl;
    }

    function openBlankEmail() {
        const subject = STORES[currentStore].emailSubject;
        window.location.href = `mailto:?subject=${encodeURIComponent(subject)}`;
    }

    window.copyText = function(text, type) {
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(() => {
                showToast(type + " berhasil disalin!");
            }).catch(err => {
                fallbackCopyText(text, type);
            });
        } else {
            fallbackCopyText(text, type);
        }
    };

    function fallbackCopyText(text, type) {
        const tempInput = document.createElement("textarea");
        tempInput.value = text;
        tempInput.style.position = "absolute";
        tempInput.style.left = "-9999px";
        document.body.appendChild(tempInput);
        tempInput.select();
        
        try {
            document.execCommand("copy");
            showToast(type + " berhasil disalin!");
        } catch (err) {
            showToast("Gagal menyalin " + type);
        }
        document.body.removeChild(tempInput);
    }

    function showToast(message) {
        const toast = document.getElementById('toast');
        toast.innerText = message;
        toast.classList.add('show');
        setTimeout(() => { toast.classList.remove('show'); }, 3000);
    }

    async function submitData(event, action, rowIndex = null) {
        event.preventDefault();
        const storeInfo = STORES[currentStore];

        const btn = event.target.querySelector('button[type="submit"]');
        const originalText = btn.innerText;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyimpan...';
        btn.disabled = true;

        let title, imageUrl, productUrl, description;
        if(action === 'create') {
            title = document.getElementById('addTitle').value;
            imageUrl = document.getElementById('addImageUrl').value;
            productUrl = document.getElementById('addProductUrl').value;
            description = document.getElementById('addDesc').value;
        } else {
            title = document.getElementById(`editTitle_${rowIndex}`).value;
            imageUrl = document.getElementById(`editImage_${rowIndex}`).value;
            productUrl = document.getElementById(`editProduct_${rowIndex}`).value;
            description = document.getElementById(`editDesc_${rowIndex}`).value;
        }

        try {
            const response = await fetch(storeInfo.url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ action, store: currentStore, key: APP_PIN, title, imageUrl, productUrl, description, rowIndex })
            });
            const text = await response.text();
            let result;
            try {
                result = JSON.parse(text);
            } catch(e) {
                showToast("Gagal menyimpan: Akses Apps Script dibatasi (Pilih 'Anyone').");
                return;
            }
            
            if(result.status === 'success') {
                showToast("Data berhasil disimpan!");
                await fetchData(true); 
            } else {
                showToast(result.message || "Gagal menyimpan data!");
            }
        } catch(error) {
            showToast("Terjadi kesalahan jaringan.");
        } finally {
            if(action === 'create') event.target.reset();
            btn.innerText = originalText;
            btn.disabled = false;
        }
    }

    // ==========================================
    // FUNGSI KEAMANAN AKSES PRIVAT (PIN LOCK)
    // ==========================================
    function checkAuth() {
        const savedPin = sessionStorage.getItem('LICUART_AUTH_PIN') || localStorage.getItem('LICUART_AUTH_PIN');
        if (savedPin === APP_PIN) {
            document.getElementById('authModal').classList.add('hidden');
            fetchData();
        } else {
            document.getElementById('authModal').classList.remove('hidden');
        }
    }

    function verifyPin(e) {
        e.preventDefault();
        const input = document.getElementById('pinInput').value.trim();
        const errEl = document.getElementById('pinError');
        if (input === APP_PIN) {
            localStorage.setItem('LICUART_AUTH_PIN', input);
            errEl.classList.add('hidden');
            document.getElementById('pinInput').value = '';
            document.getElementById('authModal').classList.add('hidden');
            showToast("Akses Privat Dibuka!");
            fetchData();
        } else {
            errEl.classList.remove('hidden');
            document.getElementById('pinInput').value = '';
            document.getElementById('pinInput').focus();
        }
    }

    function lockApp() {
        localStorage.removeItem('LICUART_AUTH_PIN');
        sessionStorage.removeItem('LICUART_AUTH_PIN');
        products = [];
        document.getElementById('productList').innerHTML = '';
        document.getElementById('authModal').classList.remove('hidden');
        showToast("Aplikasi Dikunci.");
    }

    // Jalankan aplikasi
    updateDinoJoyoUI();
    checkAuth();

</script>
