<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Mencegah Google / Mesin Pencari mengindeks link GitHub Anda -->
    <meta name="robots" content="noindex, nofollow">
    <title>LICUART PRODUCT</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- html2canvas untuk Download Gambar -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <!-- jsPDF untuk Download PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <!-- QRCode.js untuk Generate QR Code -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
        body { 
            font-family: 'Inter', sans-serif; 
            background-color: #000000; /* Dark Mode */
            color: #ffffff;
            -webkit-tap-highlight-color: transparent;
        }
        .line-clamp-3 {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;  
            overflow: hidden;
        }
        .line-clamp-1 {
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;  
            overflow: hidden;
        }
        /* Toast Animation */
        .toast {
            position: fixed;
            bottom: 80px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background-color: #374151;
            color: white;
            padding: 12px 24px;
            border-radius: 9999px;
            font-size: 14px;
            opacity: 0;
            transition: all 0.3s ease;
            z-index: 100;
        }
        .toast.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }
        
        #productModal, #calendarModal {
            overflow-y: auto;
        }
    </style>
</head>
<body class="bg-black pb-24">

    <!-- LAYAR KUNCI PRIVAT (PIN LOCK SCREEN) -->
    <div id="authModal" class="fixed inset-0 bg-black z-[100] flex flex-col justify-center items-center p-6">
        <div class="w-full max-w-xs bg-gray-900 border border-gray-800 rounded-3xl p-6 shadow-2xl text-center">
            <div class="w-16 h-16 bg-amber-500/10 border border-amber-500/30 rounded-2xl flex items-center justify-center mx-auto mb-4 text-amber-400 shadow-inner">
                <i class="fas fa-user-shield text-2xl"></i>
            </div>
            <h2 class="text-lg font-extrabold text-white tracking-wide mb-1">AKSES PRIVAT</h2>
            <p class="text-xs text-gray-400 mb-5">Masukkan PIN keamanan untuk membuka katalog toko Anda.</p>
            
            <form onsubmit="verifyPin(event)" class="space-y-3">
                <input type="password" id="pinInput" placeholder="••••••" required autofocus
                    class="w-full bg-black text-white text-center text-xl tracking-[0.5em] font-black py-3 px-4 rounded-xl border border-gray-700 focus:outline-none focus:border-amber-500">
                <p id="pinError" class="text-[11px] text-red-400 font-medium hidden">PIN yang Anda masukkan salah!</p>
                <button type="submit" class="w-full py-3 bg-gradient-to-r from-yellow-500 via-amber-500 to-yellow-600 text-black font-extrabold rounded-xl text-xs hover:brightness-110 transition-all shadow-lg">
                    <i class="fas fa-unlock-alt mr-1.5"></i> BUKA APLIKASI
                </button>
            </form>
        </div>
    </div>

    <!-- Top Navigation / Header -->
    <div class="fixed top-0 left-0 right-0 bg-gray-900 border-b border-gray-800 z-40 px-4 py-3 shadow-md">
        <div class="flex justify-between items-center mb-2 max-w-md mx-auto">
            <h1 id="appTitle" class="text-xl font-bold tracking-wider text-white">LICUART PRODUCT</h1>
            <div class="flex items-center gap-2">
                <!-- Store Selector -->
                <select id="storeSelector" onchange="changeStore()" class="bg-gray-800 text-white text-xs py-1 px-2 rounded-lg border border-gray-700 focus:outline-none focus:border-amber-500 font-bold">
                    <option value="licuart">LICUART</option>
                    <option value="rifath">RIFATH</option>
                    <option value="mintvite">MINTVITE</option>
                </select>
                <!-- Tombol Kunci Kembali -->
                <button onclick="lockApp()" class="bg-gray-800 hover:bg-red-950/60 text-gray-400 hover:text-red-400 w-7 h-7 rounded-lg border border-gray-700 flex items-center justify-center text-xs transition-colors" title="Kunci Aplikasi">
                    <i class="fas fa-lock"></i>
                </button>
            </div>
        </div>
        <!-- Search Bar with Refresh Button -->
        <div class="flex gap-2 max-w-md mx-auto">
            <div class="relative flex-1">
                <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-500"></i>
                <input type="text" id="searchInput" onkeyup="handleSearch()" placeholder="Cari nama atau kode produk..." 
                    class="w-full bg-gray-800 text-white pl-10 pr-4 py-2 rounded-full border border-gray-700 focus:outline-none focus:border-amber-500 text-sm">
            </div>
            <button onclick="forceRefresh()" class="bg-gray-800 w-10 h-10 rounded-full border border-gray-700 flex items-center justify-center text-gray-400 hover:text-white focus:outline-none transition-colors shadow-sm" title="Muat Ulang Data (Hapus Cache)">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>
    </div>

    <!-- Main Content Area -->
    <div id="app-content" class="pt-28 px-4 max-w-md mx-auto">
        <!-- Feature Hari Ini / Dino Joyo (Hanya Tampil di Mode Home) -->
        <div id="dinoJoyoWidget" class="bg-[#13111C] border border-[#272238] p-4 rounded-3xl shadow-xl mb-6">
            <!-- Navigasi Tab (Hari ini, Besok, Atur Tanggal) -->
            <div class="flex items-center justify-between bg-[#1C182B] p-1.5 rounded-2xl mb-4 text-xs font-semibold">
                <button id="btnTabToday" onclick="selectDinoTab('today')" class="flex-1 py-2 rounded-xl text-center transition-all bg-gradient-to-r from-purple-600 to-indigo-600 text-white shadow">
                    Hari ini
                </button>
                <button id="btnTabTomorrow" onclick="selectDinoTab('tomorrow')" class="flex-1 py-2 rounded-xl text-center text-gray-400 hover:text-white transition-all">
                    Besok
                </button>
                <button id="btnTabCustom" onclick="openCalendarModal()" type="button" class="flex-1 py-2 rounded-xl text-center text-gray-400 hover:text-white transition-all flex items-center justify-center gap-1.5">
                    <i class="far fa-calendar-alt text-xs"></i> Atur Tanggal
                </button>
            </div>

            <!-- Date Pill Badge -->
            <div class="text-center mb-4">
                <span id="dinoDateLabel" class="inline-block bg-[#241E38] text-purple-200 border border-purple-800/40 text-xs font-semibold px-4 py-1.5 rounded-full shadow-inner">
                    Minggu, 13 September 2026
                </span>
            </div>

            <!-- Kartu Info (Arah & Jam Joyo) -->
            <div class="space-y-3">
                <!-- Card 1: Arah Utama Terbaik -->
                <div class="bg-[#1C182B]/90 border border-[#2F2946] hover:border-purple-600/50 rounded-2xl p-3.5 flex items-center justify-between transition-all">
                    <div class="flex items-center gap-3.5">
                        <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-purple-900/80 to-indigo-900/80 border border-purple-500/30 flex items-center justify-center text-purple-300 shadow-md">
                            <i class="fas fa-compass text-base"></i>
                        </div>
                        <div>
                            <span class="text-[10px] font-bold text-purple-300/70 uppercase tracking-wider block">ARAH UTAMA TERBAIK</span>
                            <span id="dinoArahValue" class="text-sm font-extrabold text-white block">Lor (Utara)</span>
                        </div>
                    </div>
                    <i class="fas fa-chevron-right text-purple-400/60 text-xs"></i>
                </div>

                <!-- Card 2: Jam Joyo -->
                <div class="bg-[#1C182B]/90 border border-[#2F2946] hover:border-purple-600/50 rounded-2xl p-3.5 flex items-center justify-between transition-all">
                    <div class="flex items-center gap-3.5">
                        <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-purple-900/80 to-indigo-900/80 border border-purple-500/30 flex items-center justify-center text-purple-300 shadow-md">
                            <i class="fas fa-clock text-base"></i>
                        </div>
                        <div>
                            <span class="text-[10px] font-bold text-purple-300/70 uppercase tracking-wider block">JAM JOYO</span>
                            <span id="dinoJamValue" class="text-sm font-extrabold text-white block">09.00 - 10.59 Pagi</span>
                        </div>
                    </div>
                    <i class="fas fa-chevron-right text-purple-400/60 text-xs"></i>
                </div>

                <!-- Tombol Toggle Rincian Selengkapnya -->
                <button id="btnToggleDinoDetails" onclick="toggleDinoDetails()" class="w-full mt-2 py-2.5 px-4 rounded-2xl bg-[#1C182B]/80 hover:bg-[#1C182B] border border-[#2F2946] text-xs font-semibold text-purple-300 flex items-center justify-between transition-all shadow-sm">
                    <span class="flex items-center gap-2">
                        <i class="fas fa-list-alt text-purple-400"></i>
                        <span>Rincian Selengkapnya</span>
                    </span>
                    <i id="dinoDetailsChevron" class="fas fa-chevron-down text-purple-400/80 text-xs transition-transform duration-300"></i>
                </button>

                <!-- Panel Detail -->
                <div id="dinoDetailsContainer" class="hidden mt-3 p-3.5 bg-[#1C182B]/60 border border-[#2F2946] rounded-2xl space-y-3">
                    <!-- Rincian Bobot Arah -->
                    <div>
                        <span class="text-[10px] font-extrabold text-purple-300/70 uppercase tracking-wider block mb-2 flex items-center gap-1.5">
                            <i class="fas fa-compass text-xs text-purple-400"></i> Bobot Nilai Arah Angin
                        </span>
                        <div id="dinoArahDetails" class="grid grid-cols-4 gap-1.5 text-center">
                            <!-- Populated by JS -->
                        </div>
                    </div>

                    <!-- Rincian Jam & Status -->
                    <div class="pt-2 border-t border-[#2F2946]">
                        <span class="text-[10px] font-extrabold text-purple-300/70 uppercase tracking-wider block mb-2 flex items-center gap-1.5">
                            <i class="fas fa-history text-xs text-purple-400"></i> Rincian Jadwal Jam & Status
                        </span>
                        <div id="dinoJamDetails" class="space-y-1.5">
                            <!-- Populated by JS -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Loading Indicator -->
        <div id="loading" class="text-center py-10 hidden">
            <i class="fas fa-circle-notch fa-spin text-3xl text-gray-500"></i>
            <p class="mt-2 text-gray-400 text-sm">Memuat data terbaru...</p>
        </div>

        <!-- Container untuk List Produk -->
        <div id="productList" class="flex flex-col gap-4">
            <!-- Data produk akan dirender di sini oleh JavaScript -->
        </div>
    </div>

    <!-- Modal Google Kalender / Custom Date Picker -->
    <div id="calendarModal" class="fixed inset-0 bg-black/90 z-50 hidden flex-col justify-center items-center p-4 backdrop-blur-sm">
        <div class="w-full max-w-xs bg-[#181424] border border-[#2F2946] rounded-3xl p-5 shadow-2xl relative flex flex-col">
            <!-- Header Modal -->
            <div class="flex justify-between items-center mb-4">
                <div class="flex items-center gap-2 text-purple-400 font-bold text-sm">
                    <i class="fab fa-google text-lg text-purple-400"></i>
                    <span>Pilih Tanggal</span>
                </div>
                <button onclick="closeCalendarModal()" class="text-gray-400 hover:text-white w-8 h-8 rounded-full bg-[#241E38] flex items-center justify-center transition-colors">
                    <i class="fas fa-times text-xs"></i>
                </button>
            </div>

            <!-- Month & Year Controls -->
            <div class="flex justify-between items-center bg-[#201A30] px-3 py-2 rounded-2xl mb-4 border border-[#2F2946]">
                <button onclick="changeCalendarMonth(-1)" class="text-purple-300 hover:text-white p-1.5 rounded-xl hover:bg-purple-900/40 transition-all">
                    <i class="fas fa-chevron-left text-xs"></i>
                </button>
                <span id="calendarMonthYear" class="text-xs font-bold text-white tracking-wide">September 2026</span>
                <button onclick="changeCalendarMonth(1)" class="text-purple-300 hover:text-white p-1.5 rounded-xl hover:bg-purple-900/40 transition-all">
                    <i class="fas fa-chevron-right text-xs"></i>
                </button>
            </div>

            <!-- Days Header -->
            <div class="grid grid-cols-7 gap-1 text-center mb-2 text-[10px] font-bold text-purple-300/60 uppercase">
                <div>Min</div>
                <div>Sen</div>
                <div>Sel</div>
                <div>Rab</div>
                <div>Kam</div>
                <div>Jum</div>
                <div>Sab</div>
            </div>

            <!-- Calendar Days Grid -->
            <div id="calendarDaysGrid" class="grid grid-cols-7 gap-1 mb-4">
                <!-- Days rendered dynamically by JS -->
            </div>

            <!-- Action Buttons -->
            <div class="flex justify-between items-center pt-3 border-t border-[#2F2946]">
                <button onclick="selectTodayFromCalendar()" class="px-3 py-1.5 bg-[#272238] hover:bg-purple-900/50 border border-purple-500/30 text-purple-300 text-xs font-semibold rounded-xl transition-all">
                    <i class="fas fa-calendar-day mr-1"></i> Hari Ini
                </button>
                <a id="btnOpenGCal" href="https://calendar.google.com" target="_blank" class="text-[10px] text-purple-400 hover:text-purple-200 flex items-center gap-1 font-medium">
                    <i class="fas fa-external-link-alt text-[9px]"></i> Google Calendar
                </a>
            </div>
        </div>
    </div>

    <!-- Modal Download Card -->
    <div id="productModal" class="fixed inset-0 bg-black bg-opacity-95 z-50 hidden flex-col justify-center items-center p-4">
        <div class="w-full max-w-[310px] flex flex-col relative my-auto">
            
            <!-- Tombol Close Modal -->
            <button onclick="closeProductModal()" class="absolute -top-3 -right-3 text-gray-400 hover:text-white z-10 w-8 h-8 bg-gray-800 rounded-full flex items-center justify-center border-2 border-gray-900 shadow-xl">
                <i class="fas fa-times text-sm"></i>
            </button>
            
            <!-- Area Capture PNG / PDF -->
            <div id="captureArea" class="bg-white pt-4 pb-5 px-4 flex flex-col relative rounded-2xl border border-gray-200 shadow-2xl">
                
                <!-- 1. Garis Lengkung Atas -->
                <div id="modalTopLine" class="absolute top-0 left-0 right-0 h-3 bg-gradient-to-r from-amber-600 via-yellow-400 to-black rounded-t-2xl"></div>
                
                <!-- 2. Header Badges -->
                <div class="flex justify-between items-center mt-1 mb-3">
                    <span id="watermarkStudio" class="text-[9px] font-extrabold text-amber-300 bg-gradient-to-r from-black via-zinc-900 to-amber-950 px-2.5 py-0.5 rounded-full tracking-wider border border-amber-500/40">LICUART STUDIO</span>
                    <span id="modalIdBadge" class="hidden text-[10px] font-bold text-gray-400 bg-gray-50 px-2.5 py-0.5 border border-gray-100 rounded-full"></span>
                </div>

                <!-- 3. Judul Produk -->
                <h2 id="modalTitle" class="text-[15px] leading-tight font-black text-[#1a202c] text-center uppercase tracking-wide break-words font-sans mb-3 px-1">Judul Produk</h2>
                
                <!-- 4. Gambar Produk Utama -->
                <div class="flex justify-center items-center mb-4 bg-gray-50 rounded-2xl p-2 border border-gray-100">
                    <img id="modalImage" src="" alt="Product" class="w-full h-auto max-h-[260px] object-contain rounded-xl shadow-sm" onerror="this.src='https://placehold.co/300x300/1f2937/d1d5db?text=Error'">
                </div>

                <!-- 5. Kotak Info QR Code & Link -->
                <div class="border border-gray-200 rounded-[20px] p-3 bg-white flex items-center gap-3 mb-4 shadow-sm">
                    <!-- QR Code -->
                    <div class="flex-shrink-0 bg-white p-0.5 flex items-center justify-center border border-gray-100 rounded-lg">
                        <div id="modalQrCode"></div>
                    </div>
                    
                    <!-- Link Info -->
                    <div class="flex-1 min-w-0 flex flex-col justify-between py-0.5">
                        <span class="text-[8px] font-extrabold text-gray-400 tracking-widest uppercase leading-none">PRODUCT LINK</span>
                        <p id="modalLink" class="text-[9px] font-bold text-amber-600 break-all leading-snug my-1.5 hover:underline"></p>
                        <span class="text-[9px] text-gray-400 italic leading-none">Scan QR code</span>
                    </div>
                </div>
                
                <!-- 6. Footer Digital Assets -->
                <div class="pt-3 border-t border-dotted border-gray-300 text-center">
                    <p id="watermarkFooter" class="text-[8px] font-bold text-gray-400 tracking-[0.15em] uppercase">LICUART Premium Digital Assets</p>
                </div>
            </div>
            
            <!-- Tombol Aksi Download -->
            <div class="mt-3 flex gap-2">
                <button id="downloadBtn" onclick="downloadProductCard(event, 'png')" class="flex-1 py-2.5 bg-gradient-to-r from-yellow-500 via-amber-500 to-yellow-600 text-black font-extrabold rounded-xl text-xs hover:brightness-110 flex justify-center items-center transition-all shadow-lg border border-amber-300">
                    <i class="fas fa-image mr-1.5"></i> Download PNG
                </button>
                <button id="downloadPdfBtn" onclick="downloadProductCard(event, 'pdf')" class="flex-1 py-2.5 bg-red-600 text-white rounded-xl text-xs font-semibold hover:bg-red-700 flex justify-center items-center transition-colors shadow-lg">
                    <i class="fas fa-file-pdf mr-1.5"></i> Download PDF
                </button>
            </div>
        </div>
    </div>

    <!-- Bottom Navigation -->
    <div class="fixed bottom-0 left-0 right-0 bg-gray-900 border-t border-gray-800 z-40 px-4 py-2.5">
        <div class="flex justify-around items-center max-w-md mx-auto">
            <button onclick="switchMode('home')" id="nav-home" class="flex flex-col items-center text-white transition-colors">
                <i class="fas fa-home text-lg mb-0.5"></i>
                <span class="text-[10px]">Home</span>
            </button>

            <button onclick="switchMode('produk')" id="nav-produk" class="flex flex-col items-center text-gray-500 hover:text-white transition-colors">
                <i class="fas fa-box text-lg mb-0.5"></i>
                <span class="text-[10px]">Produk</span>
            </button>

            <button onclick="switchMode('edit')" id="nav-edit" class="flex flex-col items-center text-gray-500 hover:text-white transition-colors">
                <i class="fas fa-edit text-lg mb-0.5"></i>
                <span class="text-[10px]">Edit</span>
            </button>
            
            <button onclick="openBlankEmail()" class="flex flex-col items-center text-gray-500 hover:text-white transition-colors focus:outline-none">
                <i class="fas fa-envelope text-lg mb-0.5"></i>
                <span class="text-[10px]">Email</span>
            </button>
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="toast shadow-lg border border-gray-700">Notifikasi</div>

<script>
    // ==========================================
    // KONFIGURASI PIN KEAMANAN PRIVAT
    // ==========================================
    // Ubah angka PIN ini sesuai keinginan Anda (Samakan dengan SECRET_KEY di Code.gs)
    const APP_PIN = "123456";

    // ==========================================
    // KONFIGURASI 3 TOKO & GOOGLE APPS SCRIPT
    // ==========================================
    const STORES = {
        licuart: {
            name: "LICUART",
            url: "https://script.google.com/macros/s/AKfycbzQ9WD1Ie6HsWZ7porq9yTA3wgvJN7pFqEDCCIaiTGSiP4fJcViifJACVc7SvJJ2kg-Dw/exec",
            emailSubject: "LICUART You made a sale on Etsy",
            themeLine: "absolute top-0 left-0 right-0 h-3 bg-gradient-to-r from-amber-600 via-yellow-400 to-black rounded-t-2xl",
            themeBadge: "text-[9px] font-extrabold text-amber-300 bg-gradient-to-r from-black via-zinc-900 to-amber-950 px-2.5 py-0.5 rounded-full tracking-wider border border-amber-500/40",
            themeLink: "text-[9px] font-bold text-amber-600 break-all leading-snug my-1.5 hover:underline"
        },
        rifath: {
            name: "RIFATH",
            url: "https://script.google.com/macros/s/AKfycbxUHBrT7gf1H3JVOb6puhUmdRwGUuJvNJ831V051MKoHkhSe28dTO_e3ZoretzYu84Rrw/exec",
            emailSubject: "Rifat You made a sale on Etsy",
            themeLine: "absolute top-0 left-0 right-0 h-3 bg-gradient-to-r from-blue-600 via-cyan-400 to-slate-900 rounded-t-2xl",
            themeBadge: "text-[9px] font-extrabold text-cyan-300 bg-gradient-to-r from-slate-950 via-blue-950 to-cyan-950 px-2.5 py-0.5 rounded-full tracking-wider border border-cyan-500/40",
            themeLink: "text-[9px] font-bold text-blue-600 break-all leading-snug my-1.5 hover:underline"
        },
        mintvite: {
            name: "MINTVITE",
            url: "https://script.google.com/macros/s/AKfycbxDuvq_qD6j6MZ759VnODAY09Jzq2Kiml89Zzih45U0OYk2snv496kP4TI7LmUxZHjmIw/exec",
            emailSubject: "MINTVITE You made a sale on Etsy",
            themeLine: "absolute top-0 left-0 right-0 h-3 bg-gradient-to-r from-emerald-600 via-teal-400 to-teal-950 rounded-t-2xl",
            themeBadge: "text-[9px] font-extrabold text-emerald-300 bg-gradient-to-r from-teal-950 via-emerald-950 to-green-950 px-2.5 py-0.5 rounded-full tracking-wider border border-emerald-500/40",
            themeLink: "text-[9px] font-bold text-emerald-600 break-all leading-snug my-1.5 hover:underline"
        }
    };

    let currentStore = 'licuart';
    let products = [];
    let currentMode = 'home'; // home | produk | edit
    let currentModalTitle = ""; 
    let currentModalProductUrl = ""; 

    // ==========================================
    // FUNGSI GANTI TOKO & REFRESH
    // ==========================================
    function changeStore() {
        const selector = document.getElementById('storeSelector');
        currentStore = selector.value;
        const storeInfo = STORES[currentStore];

        // Update Judul Header & Watermark Modal PDF/PNG
        document.getElementById('appTitle').innerText = `${storeInfo.name} PRODUCT`;
        document.getElementById('watermarkStudio').innerText = `${storeInfo.name} STUDIO`;
        document.getElementById('watermarkFooter').innerText = `${storeInfo.name} Premium Digital Assets`;

        // Update Tema Warna Card PDF/PNG sesuai toko
        document.getElementById('modalTopLine').className = storeInfo.themeLine;
        document.getElementById('watermarkStudio').className = storeInfo.themeBadge;
        document.getElementById('modalLink').className = storeInfo.themeLink;

        // Bersihkan cache toko tersebut saat berpindah agar selalu menarik data segar
        localStorage.removeItem(`${currentStore}_products_cache`);
        products = [];
        fetchData(true);
    }

    function forceRefresh() {
        localStorage.removeItem(`${currentStore}_products_cache`);
        showToast(`Memuat ulang data ${STORES[currentStore].name}...`);
        fetchData(true);
    }

    // ==========================================
    // LOGIKA & DATA FITUR DINO JOYO
    // ==========================================
    let dinoActiveTab = 'today'; // today | tomorrow | custom
    let customDinoDate = new Date();
    let viewCalendarDate = new Date();

